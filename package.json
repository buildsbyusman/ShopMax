{
  "name": "shopmax-ecommerce",
  "version": "1.0.0",
  "description": "Professional E-commerce Platform with CJ Dropshipping Integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:client",
    "build:client": "webpack --mode production",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "docker:build": "docker build -t shopmax-ecommerce .",
    "docker:run": "docker run -p 3000:3000 shopmax-ecommerce"
  },
  "keywords": [
    "ecommerce",
    "nodejs",
    "express",
    "postgresql",
    "stripe",
    "paypal",
    "dropshipping"
  ],
  "author": "ShopMax Team",
  "license": "MIT",
