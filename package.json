    "swagger-ui-express": "^5.0.0",
    "swagger-jsdoc": "^6.2.8",
    "i18n": "^0.15.1",
    "moment": "^2.29.4",
    "uuid": "^9.0.1",
    "crypto": "^1.0.1",
    "express-session": "^1.17.3",
